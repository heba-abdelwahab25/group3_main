# Root environment configuration for Hybrid PQC Project

# Flask Server settings
FLASK_APP=run.py
FLASK_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Proxy settings
PROXY_HOST=127.0.0.1
PROXY_PORT=7000
PROXY_USE_SSL=1

# Traffic Generator settings
TRAFFIC_NODES=50
TRAFFIC_SLEEP=1
MALICIOUS_RATE=0.1

# Integration Runner settings
PROXY_ENV_FILE=proxy/.env
