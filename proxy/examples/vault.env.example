#############################################
# Vault-backed TLS for proxy/proxy.py
# Copy to `.env` (or export in your shell) and fill in real values.
#############################################

PROXY_USE_SSL=true
CERT_STORAGE_BACKEND=vault
PROXY_CERT_FILE=/run/proxy-certs/server.crt
PROXY_KEY_FILE=/run/proxy-certs/server.key
PROXY_CA_FILE=/run/proxy-certs/ca.crt

# Vault connection
VAULT_ADDR=https://vault.example.com:8200
# Use VAULT_TOKEN_FILE to avoid putting secrets directly in env
VAULT_TOKEN=
# VAULT_TOKEN_FILE=/path/to/token

# PKI role / issuance params
VAULT_PKI_ROLE=proxy
VAULT_COMMON_NAME=proxy.local
VAULT_ALT_NAMES=proxy,proxy.internal,127.0.0.1
VAULT_MOUNT_POINT=pki
VAULT_TTL=24h

# mTLS (optional)
PROXY_REQUIRE_CLIENT_CERT=false
# PROXY_CLIENT_CA_FILE=/etc/ssl/clients.pem

# Audit / logging (optional)
PROXY_AUDIT_LOG_PATH=proxy/logs/proxy_audit.log

# Reload cadence
CERT_REFRESH_SECONDS=300
# Force re-issuance even if revision unchanged (e.g., daily)
# CERT_FORCE_ROTATION_SECONDS=86400


